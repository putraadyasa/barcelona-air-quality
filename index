    <div class="code-wrap" id="code-cleaning" hidden>
      <pre>-- 04_cleaning_air_quality.sql
-- Remove 'NA' strings, deduplicate stations using median,
-- and normalise district names for joining.

WITH raw AS (
  SELECT
    station_name,
    district,
    NULLIF(value, 'NA') AS value_clean,
    pollutant
  FROM `barcelona.air_quality_nov2017`
  WHERE pollutant = 'NO2'
),
median_per_district AS (
  SELECT
    district,
    PERCENTILE_CONT(CAST(value_clean AS FLOAT64), 0.5)
      OVER (PARTITION BY district) AS median_value
  FROM raw
  WHERE value_clean IS NOT NULL
)
SELECT
  TRIM(REPLACE(REPLACE(district, 'à', 'a'), 'è', 'e')) AS district_clean,
  ROUND(AVG(median_value), 2) AS avg_NO2
FROM median_per_district
GROUP BY district_clean
ORDER BY avg_NO2 DESC;</pre>
